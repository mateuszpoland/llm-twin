# --- Local infrastructure (docker-compose) ---
# Copy to .env and adjust. .env is gitignored; these are local dev values only.

ZENML_DB_ROOT_PASSWORD=zenml
ZENML_SERVER_PORT=8237
ZENML_DEFAULT_USER_NAME=default
ZENML_DEFAULT_USER_PASSWORD=zenml

# --- Warehouse (Postgres + pgvector) ---
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin
POSTGRES_DB=twin
POSTGRES_PORT=5432
ADMINER_PORT=8080
APP_UID=1000
APP_GID=1000

# --- Embeddings (Cohere) ---
# Get a key at https://dashboard.cohere.com/api-keys
# Copy this block into .env and paste your key.
COHERE_API_KEY=
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIM=1536
